+import { assert, assertEquals } from "jsr:@std/assert@1";
+import { addDays, allPaid, buildSchedule, daysUntil, dueNow, instalmentCount, needReminder, payOptions, readSchedule, splitCents } from "./trip-builder-pay.ts";
+
+const NOW = new Date("2026-10-20T10:00:00Z");
+const plus = (n: number) => addDays("2026-10-20", n);
+const sum = (xs: { amount: number }[]) => Math.round(xs.reduce((a, x) => a + x.amount * 100, 0));
+
+Deno.test("days until departure counts whole UTC days", () => {
+  assertEquals(daysUntil("2026-10-20", NOW), 0);
+  assertEquals(daysUntil("2026-12-19", NOW), 60);
+  assertEquals(daysUntil("2026-10-10", NOW), -10);
+  assertEquals(daysUntil(null, NOW), null);
+  assertEquals(daysUntil("nonsense", NOW), null);
+});
+
+Deno.test("splitting a balance never loses or invents a cent", () => {
+  for (const [total, n] of [[60000, 2], [60001, 3], [99999, 6], [2000, 2], [1, 1]]) {
+    const parts = splitCents(total, n);
+    assertEquals(parts.length, n);
+    assertEquals(parts.reduce((a, b) => a + b, 0), total);
+  }
+  assertEquals(splitCents(10001, 3), [3333, 3333, 3335]);
+});
+
+Deno.test("instalments need 60+ days, one every 30 days, the last 7+ days before departure", () => {
+  assertEquals(instalmentCount(59, 600), 0, "59 days is too close");
+  assertEquals(instalmentCount(60, 600), 2);
+  assertEquals(instalmentCount(120, 600), 4);
+  assertEquals(instalmentCount(400, 600), 6, "capped at six");
+  assertEquals(instalmentCount(null, 600), 0, "no date, no instalments");
+  assertEquals(instalmentCount(120, 59), 2, "$59 still fits two of $20 or more");
+  assertEquals(instalmentCount(120, 39), 0, "$39 can't make two payments of $20");
+});
+
+Deno.test("'later' charges the card 7 days before departure", () => {
+  const s = buildSchedule("later", 450, plus(40), NOW);
+  assertEquals(s.length, 1);
+  assertEquals(s[0].due, plus(33));
+  assertEquals(s[0].how, "card");
+  assertEquals(s[0].amount, 450);
+});
+
+Deno.test("'now' is one payment today through Checkout", () => {
+  const s = buildSchedule("now", 450, plus(40), NOW);
+  assertEquals([s.length, s[0].due, s[0].how], [1, "2026-10-20", "checkout"]);
+});
+
+Deno.test("instalments: first now through Checkout, the rest on the card every 30 days, all before the last-week cut-off", () => {
+  for (const days of [60, 75, 97, 150, 400]) {
+    const s = buildSchedule("instalments", 601, plus(days), NOW);
+    assert(s.length >= 2 && s.length <= 6);
+    assertEquals(sum(s), 60100, `parts add up (${days} days out)`);
+    assertEquals([s[0].how, s[0].due], ["checkout", "2026-10-20"]);
+    assert(s.slice(1).every((i, k) => i.how === "card" && i.due === plus(30 * (k + 1))));
+    assert(s[s.length - 1].due <= addDays(plus(days), -7), `last payment is at least 7 days before departure (${days} days out)`);
+  }
+});
+
+Deno.test("options: now always; later and instalments only with a saved card and enough time", () => {
+  const plans = (o: Parameters<typeof payOptions>[0]) => payOptions({ ...o, now: NOW }).map((x) => x.plan);
+  assertEquals(plans({ balance: 500, start: plus(120), cardSaved: true }), ["now", "later", "instalments"]);
+  assertEquals(plans({ balance: 500, start: plus(30), cardSaved: true }), ["now", "later"], "30 days out: no instalments");
+  assertEquals(plans({ balance: 500, start: plus(7), cardSaved: true }), ["now"], "leaving in a week: the 7-day charge date is already here");
+  assertEquals(plans({ balance: 500, start: plus(8), cardSaved: true }), ["now", "later"], "8 days out: charge tomorrow");
+  assertEquals(plans({ balance: 500, start: plus(120), cardSaved: false }), ["now"], "no saved card (deposit taken before this existed)");
+  assertEquals(plans({ balance: 500, start: null, cardSaved: true }), ["now"], "no date: nothing to schedule against");
+  assertEquals(plans({ balance: 0.5, start: plus(120), cardSaved: true }), [], "nothing to pay");
+});
+
+Deno.test("what is due today, and what needs a reminder", () => {
+  const s = buildSchedule("instalments", 600, plus(120), NOW);
+  s[0].status = "paid";
+  assertEquals(dueNow(s, NOW).length, 0, "nothing due the day it is booked");
+  const later = new Date("2026-11-20T10:00:00Z");
+  assertEquals(dueNow(s, later).map((i) => i.n), [2], "the second payment, 30 days on");
+  s[1].status = "failed"; s[1].retry_after = "2026-11-22T14:00:00Z";
+  assertEquals(dueNow(s, later).length, 0, "waiting for the retry date");
+  assertEquals(dueNow(s, new Date("2026-11-22T15:00:00Z")).map((i) => i.n), [2], "retry date passed");
+  assertEquals(needReminder(s, 3, new Date("2026-11-16T09:00:00Z")).map((i) => i.n), [], "already failed, not a reminder case");
+  const fresh = buildSchedule("instalments", 600, plus(120), NOW);
+  assertEquals(needReminder(fresh, 3, new Date("2026-11-16T09:00:00Z")).map((i) => i.n), [2]);
+  fresh[1].reminded = true;
+  assertEquals(needReminder(fresh, 3, new Date("2026-11-16T09:00:00Z")).length, 0, "only once");
+});
+
+Deno.test("allPaid and reading a saved schedule defensively", () => {
+  const s = buildSchedule("instalments", 600, plus(120), NOW);
+  assert(!allPaid(s));
+  s.forEach((i) => (i.status = "paid"));
+  assert(allPaid(s));
+  assertEquals(allPaid([]), false);
+  assertEquals(readSchedule(null), []);
+  assertEquals(readSchedule("junk"), []);
+  const r = readSchedule([{ n: 1, amount: "12.5", due: "bad", status: "weird", how: "card" }]);
+  assertEquals([r[0].amount, r[0].due, r[0].status, r[0].how], [12.5, "", "pending", "card"]);
+});
diff --git a/supabase/functions/_shared/trip-builder-pay.ts b/supabase/functions/_shared/trip-builder-pay.ts
new file mode 100644
index 0000000..4921b20
--- /dev/null
+++ b/supabase/functions/_shared/trip-builder-pay.ts
@@ -0,0 +1,101 @@
+// Trip builder: how a guest pays the rest once the crew has approved their trip (Ewan, 20 Oct 2026).
+//
+// The deposit taken when the trip was sent (and the card it was paid with) carries straight on:
+// the crew sets the balance, the guest picks how to pay it, and the plan follows the same rules
+// as ALL IN bookings:
+//   now          pay the whole balance straight away
+//   later        the saved card is charged automatically LATE_DAYS before departure (a reminder goes first)
+//   instalments  only when departure is INSTALMENT_MIN_DAYS or more away: equal payments, the first one now,
+//                the rest charged to the saved card every INSTALMENT_EVERY_DAYS days, the last at least
+//                LATE_DAYS before departure
+// Pure functions only (no Stripe, no database), so every rule here is covered by trip-builder-pay.test.ts.
+
+export const LATE_DAYS = 7;
+export const INSTALMENT_MIN_DAYS = 60;
+export const INSTALMENT_EVERY_DAYS = 30;
+export const MAX_INSTALMENTS = 6;
+export const MIN_INSTALMENT_USD = 20;
+export const RETRY_DAYS = 2;
+export const MAX_ATTEMPTS = 4;
+
+export type Plan = "now" | "later" | "instalments";
+export type ItemStatus = "pending" | "paid" | "failed" | "gave_up";
+export type Item = {
+  n: number; amount: number; due: string; how: "checkout" | "card"; status: ItemStatus;
+  attempts: number; last_error: string | null; retry_after: string | null; paid_at: string | null; payment_intent: string | null; reminded: boolean;
+};
+export type Option = { plan: Plan; count: number; amount: number; items: { amount: number; due: string }[] };
+
+const DAY = 86_400_000;
+export const isoDay = (d: Date) => d.toISOString().slice(0, 10);
+export const parseDay = (s: string | null | undefined): Date | null => (s && /^\d{4}-\d{2}-\d{2}$/.test(s) ? new Date(`${s}T00:00:00Z`) : null);
+export function addDays(iso: string, n: number): string { return isoDay(new Date(parseDay(iso)!.getTime() + n * DAY)); }
+/** Whole days from `now` (UTC date) to a departure date. Negative once it has passed. */
+export function daysUntil(start: string | null | undefined, now = new Date()): number | null {
+  const d = parseDay(start); if (!d) return null;
+  return Math.round((d.getTime() - parseDay(isoDay(now))!.getTime()) / DAY);
+}
+
+/** Equal parts in whole cents; any odd cents go on the last payment so the parts always add up to the total. */
+export function splitCents(totalCents: number, n: number): number[] {
+  const base = Math.floor(totalCents / n), out = Array(n).fill(base) as number[];
+  out[n - 1] += totalCents - base * n;
+  return out;
+}
+
+/** How many instalments a guest can have: first one now, one every 30 days, the last at least 7 days before they leave. */
+export function instalmentCount(days: number | null, balance: number): number {
+  if (days == null || days < INSTALMENT_MIN_DAYS) return 0;
+  const byDate = Math.floor((days - LATE_DAYS) / INSTALMENT_EVERY_DAYS) + 1;
+  const byAmount = Math.floor(balance / MIN_INSTALMENT_USD);
+  const n = Math.min(MAX_INSTALMENTS, byDate, byAmount);
+  return n >= 2 ? n : 0;
+}
+
+/** The schedule for a plan. Item 1 of "now" and "instalments" is paid on a Stripe Checkout page today; later items are charged to the saved card. */
+export function buildSchedule(plan: Plan, balance: number, start: string | null, now = new Date()): Item[] {
+  const today = isoDay(now), cents = Math.round(balance * 100);
+  const mk = (n: number, c: number, due: string, how: Item["how"]): Item => ({ n, amount: c / 100, due, how, status: "pending", attempts: 0, last_error: null, retry_after: null, paid_at: null, payment_intent: null, reminded: false });
+  if (plan === "now") return [mk(1, cents, today, "checkout")];
+  if (plan === "later") return [mk(1, cents, addDays(start!, -LATE_DAYS), "card")];
+  const n = instalmentCount(daysUntil(start, now), balance);
+  return splitCents(cents, n).map((c, i) => mk(i + 1, c, addDays(today, i * INSTALMENT_EVERY_DAYS), i === 0 ? "checkout" : "card"));
+}
+
+/** What this guest can choose. "later" and "instalments" need a card saved at the deposit and a departure date. */
+export function payOptions(o: { balance: number; start: string | null; cardSaved: boolean; now?: Date }): Option[] {
+  const now = o.now ?? new Date(), days = daysUntil(o.start, now), out: Option[] = [];
+  if (!(o.balance >= 1)) return out;
+  const view = (plan: Plan): Option => { const items = buildSchedule(plan, o.balance, o.start, now); return { plan, count: items.length, amount: o.balance, items: items.map((i) => ({ amount: i.amount, due: i.due })) }; };
+  out.push(view("now"));
+  if (o.cardSaved && days != null && days > LATE_DAYS) out.push(view("later"));
+  if (o.cardSaved && instalmentCount(days, o.balance) >= 2) out.push(view("instalments"));
+  return out;
+}
+
+export const allPaid = (items: Item[]) => items.length > 0 && items.every((i) => i.status === "paid");
+export const paidSoFar = (items: Item[]) => Math.round(items.filter((i) => i.status === "paid").reduce((a, i) => a + i.amount * 100, 0)) / 100;
+
+/** Card payments that are due today (or earlier) and not waiting for a retry date. */
+export function dueNow(items: Item[], now = new Date()): Item[] {
+  const today = isoDay(now);
+  return items.filter((i) => i.how === "card" && (i.status === "pending" || i.status === "failed") && i.due <= today && (!i.retry_after || i.retry_after <= now.toISOString()));
+}
+/** Card payments due in exactly `ahead` days that nobody has been reminded about yet. */
+export function needReminder(items: Item[], ahead = 3, now = new Date()): Item[] {
+  const when = addDays(isoDay(now), ahead);
+  return items.filter((i) => i.how === "card" && i.status === "pending" && !i.reminded && i.due === when);
+}
+/** Read a saved schedule defensively (it lives in a jsonb column). */
+export function readSchedule(v: unknown): Item[] {
+  if (!Array.isArray(v)) return [];
+  return v.map((x, k) => {
+    const r = (x ?? {}) as Record<string, unknown>;
+    return {
+      n: Number(r.n) || k + 1, amount: Number(r.amount) || 0, due: parseDay(String(r.due)) ? String(r.due) : "", how: r.how === "checkout" ? "checkout" : "card",
+      status: (["pending", "paid", "failed", "gave_up"].includes(String(r.status)) ? r.status : "pending") as ItemStatus, attempts: Number(r.attempts) || 0,
+      last_error: r.last_error ? String(r.last_error).slice(0, 300) : null, retry_after: r.retry_after ? String(r.retry_after) : null, paid_at: r.paid_at ? String(r.paid_at) : null,
+      payment_intent: r.payment_intent ? String(r.payment_intent) : null, reminded: r.reminded === true,
+    };
+  });
+}
