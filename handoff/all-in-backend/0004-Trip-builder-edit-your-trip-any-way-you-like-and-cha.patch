+-- Trip builder AI chat: how many times each person (hashed IP, never the address itself) and everyone together has used it today.
+-- The trip-builder-chat Edge Function counts every request here BEFORE calling Claude and refuses once a limit is reached, so a link
+-- being shared around, or a script, can't run up a bill. Only the service role (the Edge Function) can touch it.
+create table if not exists public.trip_builder_chat_usage (
+  day    date    not null,
+  bucket text    not null,              -- 'all', or 'ip:<first 24 hex of a salted SHA-256 of the IP>'
+  hits   integer not null default 0,
+  primary key (day, bucket)
+);
+alter table public.trip_builder_chat_usage enable row level security;   -- no policies: nobody but the service role
+
+create or replace function public.trip_builder_chat_hit(p_bucket text, p_limit integer)
+returns boolean
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  n integer;
+begin
+  insert into public.trip_builder_chat_usage as u (day, bucket, hits)
+  values (current_date, p_bucket, 1)
+  on conflict (day, bucket) do update set hits = u.hits + 1
+  returning u.hits into n;
+  -- tidy up: the first request of each day also drops counts older than two weeks
+  if p_bucket = 'all' and n = 1 then
+    delete from public.trip_builder_chat_usage where day < current_date - 14;
+  end if;
+  return n <= p_limit;
+end;
+$$;
+
+revoke all on function public.trip_builder_chat_hit(text, integer) from public, anon, authenticated;
+grant execute on function public.trip_builder_chat_hit(text, integer) to service_role;
